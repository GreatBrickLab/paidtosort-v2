{
  "name": "pts-part-scanner-api",
  "version": "0.1.0-draft1",
  "description": "Headless, API-first Part Scanner backend for paidtosort (DRAFT 1, local WIP).",
  "main": "src/index.ts",
  "scripts": {
    "spec": "tsx scripts/gen-spec.ts",
    "lint:spec": "spectral lint contract/openapi.yaml --fail-severity=warn",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "db:local": "wrangler d1 migrations apply DB --local --persist-to local-d1",
    "dev": "wrangler dev --local --persist-to local-d1 --port 4794 --inspector-port 4797",
    "mock": "prism mock contract/openapi.yaml --port 4795 --host 127.0.0.1",
    "docs": "node scripts/docs.mjs",
    "gitleaks": "gitleaks dir . --redact --no-banner --config .gitleaks.toml",
    "check": "npm run spec && npm run lint:spec && npm run typecheck && npm test && npm run bundle:pages && npm run gitleaks",
    "bundle:pages": "node scripts/bundle-pages.mjs"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "hono": "^4.13.21",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.1",
    "@scalar/api-reference": "^1.83.0",
    "@stoplight/prism-cli": "^5.16.0",
    "@stoplight/spectral-cli": "^6.17.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "0.28.2",
    "miniflare": "^4.20260730.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  },
  "private": true
}
